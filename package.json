{
  "name": "markdown-reading",
  "displayName": "Markdown Reading",
  "description": "Directly read compiled markdown in the editor.",
  "version": "0.0.3",
  "publisher": "erQS",
  "icon": "unnamed.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/QianqiuerQS/Markdown-reading.git"
  },
  "homepage": "https://github.com/QianqiuerQS/Markdown-reading",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-reading.read",
        "title": "Markdown-reading"
      },
      {
        "command": "markdown-reading.editMode",
        "title": "Edit Mode"
      },
      {
        "command": "markdown-reading.readMode",
        "title": "Read Mode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdown-reading.read",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "markdown-reading.read",
          "when": "webviewId == markdownReading"
        },
        {
          "command": "markdown-reading.editMode",
          "when": "webviewId == markdownReading && !markdownReadingIsEditing"
        },
        {
          "command": "markdown-reading.readMode",
          "when": "webviewId == markdownReading && markdownReadingIsEditing"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "16.x",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "eslint": "^8.18.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "markdown-it": "^13.0.1",
    "turndown": "^7.2.2"
  }
}
